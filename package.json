{
  "name": "codex-usage-monitor",
  "version": "0.2.1",
  "description": "Codex CLI plugin and local monitor for usage, model, reasoning effort, context, cache hits, and API-equivalent cost",
  "main": "bin/codex-usage-monitor.js",
  "bin": {
    "codex-usage-monitor": "bin/codex-usage-monitor.js",
    "cum": "bin/codex-usage-monitor.js"
  },
  "type": "commonjs",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:macos": "swift run --package-path macos/CodexUsageMenuBar UsageCoreCheck",
    "build:macos": "zsh scripts/build-macos-app.sh",
    "smoke:statusline": "node bin/codex-usage-monitor.js statusline --file test/fixtures/session-basic.jsonl",
    "smoke:summary": "node bin/codex-usage-monitor.js summary --file test/fixtures/session-basic.jsonl"
  },
  "keywords": [
    "codex",
    "codex-cli",
    "plugin",
    "hooks",
    "usage",
    "tokens",
    "pricing",
    "cache"
  ],
  "author": "harveyxiacn (https://github.com/harveyxiacn)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wentao-uw/codex-usage-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/wentao-uw/codex-usage-monitor/issues"
  },
  "homepage": "https://github.com/wentao-uw/codex-usage-monitor#readme",
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "bin/",
    "docs/",
    "hooks/",
    "lib/",
    "macos/",
    "mcp/",
    "scripts/",
    "ui/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
